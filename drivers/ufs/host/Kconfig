config SCSI_UFSHCD_PCI
	tristate "PCI bus based UFS Controller support"
	depends on PCI
	help
	  This selects the PCI UFS Host Controller Interface. Select this if
	  you have UFS Host Controller with PCI Interface.

	  If you have a controller with this interface, say Y or M here.

	  If unsure, say N.

config SCSI_UFS_DWC_TC_PCI
	tristate "DesignWare pci support using a G210 Test Chip"
	depends on SCSI_UFSHCD_PCI
	help
	  Synopsys Test Chip is a PHY for prototyping purposes.

	  If unsure, say N.

config SCSI_UFSHCD_PLATFORM
	tristate "Platform bus based UFS Controller support"
	depends on HAS_IOMEM
	help
	  This selects the UFS host controller support. Select this if
	  you have an UFS controller on Platform bus.

	  If you have a controller with this interface, say Y or M here.

	  If unsure, say N.

config SCSI_UFS_MALIBU
	bool "Google Malibu UFS link diagnostic"
	depends on SCSI_UFSHCD_PLATFORM=y && COMMON_CLK_GOOGLE_MALIBU_CPM=y
	depends on GPIOLIB && PINCTRL
	depends on ARM_SMMU_V3 && IOMMU_DMA
	help
	  Build the Google Tensor G6 Malibu UFS bring-up code.
	  The code sets up the device supplies and GPIOs, checks
	  bootloader calibration data and programs the local UniPro
	  attributes before a synchronous link test. It releases the clock
	  votes only after Hibern8 and PHY power-state checks. On an
	  unqualified exit it keeps the acquired votes for this boot.
	  The diagnostic does not register a SCSI host or storage.

	  If unsure, say N.

config SCSI_UFS_MALIBU_HIBERN8_GATING_DIAG
	bool "Test stock Grizzly M-PHY Hibern8 gating"
	depends on SCSI_UFS_MALIBU && COMMON_CLK_GOOGLE_MALIBU_CPM_UFS_PREP_RELEASE
	help
	  Apply the stock D1 local M-PHY Hibern8 gating attribute
	  after link startup and test one explicit Hibern8 entry.
	  Keep the existing Deep H8 release guard and leave the host
	  without transfer queues or SCSI devices.
	  Leave disabled except when testing Grizzly diagnostics.

config SCSI_UFS_MALIBU_QUERY_DIAG
	bool "Test Grizzly device management before SCSI discovery"
	depends on SCSI_UFS_MALIBU_HIBERN8_GATING_DIAG
	help
	  Use one polled legacy transfer slot to send a NOP and read
	  bRefClkFreq on the Grizzly link diagnostic. Do not register
	  a SCSI host or start task management, scanning or recovery.
	  Leave disabled outside Grizzly diagnostic builds.

config SCSI_UFS_MALIBU_DEVICE_INIT_DIAG
	bool "Test Grizzly fDeviceInit before SCSI discovery"
	depends on SCSI_UFS_MALIBU_QUERY_DIAG
	help
	  After the clock query passes, issue one fDeviceInit SET
	  and wait for the device to clear that flag. Continue with
	  the link-only teardown and do not enumerate any LUNs.
	  Leave disabled outside Grizzly diagnostic builds.

config SCSI_UFS_MALIBU_SCSI_INQUIRY_DIAG
	bool "Test one Grizzly SCSI INQUIRY before discovery"
	depends on SCSI_UFS_MALIBU_DEVICE_INIT_DIAG
	help
	  After the device clears fDeviceInit, send a standard 36-byte
	  INQUIRY to LUN 0 over the polled link diagnostic slot. Validate
	  the response without registering a SCSI host or scanning for disks.
	  Leave disabled outside Grizzly diagnostic builds.

config SCSI_UFS_MALIBU_INQUIRY_IRQ_DIAG
	bool "Require a transfer IRQ for the Grizzly INQUIRY test"
	depends on SCSI_UFS_MALIBU_SCSI_INQUIRY_DIAG
	help
	  Keep the preflight commands polled and wait for the single INQUIRY
	  on the hardware transfer completion interrupt. Do not fall back
	  to polling if the interrupt is missing.
	  Leave disabled outside Grizzly diagnostic builds.

config SCSI_UFS_MALIBU_CAPACITY_DIAG
	bool "Test Grizzly READ CAPACITY(10) before discovery"
	depends on SCSI_UFS_MALIBU_INQUIRY_IRQ_DIAG
	help
	  After a successful INQUIRY, read the last logical block address
	  and block size of LUN 0 using the hardware transfer interrupt.
	  Do not scan for disks or read any logical blocks.
	  Leave disabled outside Grizzly diagnostic builds.

config SCSI_UFS_CDNS_PLATFORM
	tristate "Cadence UFS Controller platform driver"
	depends on SCSI_UFSHCD_PLATFORM
	help
	  This selects the Cadence-specific additions to UFSHCD platform driver.

	  If unsure, say N.

config SCSI_UFS_DWC_TC_PLATFORM
	tristate "DesignWare platform support using a G210 Test Chip"
	depends on OF && SCSI_UFSHCD_PLATFORM
	help
	  Synopsys Test Chip is a PHY for prototyping purposes.

	  If unsure, say N.

config SCSI_UFS_QCOM
	tristate "Qualcomm specific hooks to UFS controller platform driver"
	depends on SCSI_UFSHCD_PLATFORM && ARCH_QCOM
	depends on GENERIC_MSI_IRQ
	depends on RESET_CONTROLLER
	select QCOM_INLINE_CRYPTO_ENGINE if SCSI_UFS_CRYPTO
	help
	  This selects the QCOM specific additions to UFSHCD platform driver.
	  UFS host on QCOM needs some vendor specific configuration before
	  accessing the hardware which includes PHY configuration and vendor
	  specific registers.

	  Select this if you have UFS controller on QCOM chipset.
	  If unsure, say N.

config SCSI_UFS_MEDIATEK
	tristate "Mediatek specific hooks to UFS controller platform driver"
	depends on SCSI_UFSHCD_PLATFORM && ARCH_MEDIATEK
	depends on PM
	depends on RESET_CONTROLLER
	select PHY_MTK_UFS
	select RESET_TI_SYSCON
	help
	  This selects the Mediatek specific additions to UFSHCD platform driver.
	  UFS host on Mediatek needs some vendor specific configuration before
	  accessing the hardware which includes PHY configuration and vendor
	  specific registers.

	  Select this if you have UFS controller on Mediatek chipset.

	  If unsure, say N.

